#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 40

/ {
    combos {
        compatible = "zmk,combos";

        boot {
            bindings = <&bootloader>;
            key-positions = <0 11 54 53>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <11 10>;
        };

        cins {
            bindings = <&kp LC(INSERT)>;
            key-positions = <36 20>;
        };

        sins {
            bindings = <&kp LS(INS)>;
            key-positions = <56 20>;
        };
    };

    behaviors {
        encoder_sc: encoder_sc {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ENCODER_SC";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <40>;
        };
    };

    macros {
        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER &macro_param_2to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER &macro_param_1to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER>;

            label = "LM";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        LAYER0 {
            display-name = "Default";
            bindings = <
&kp GRAVE   &kp N1               &kp N2        &kp N3        &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp N7     &kp N8      &kp N9   &kp N0             &kp MINUS
&kp TAB     &kp Q                &kp W         &kp E         &kp R         &kp T   &kp Y         &kp U      &kp I       &kp O    &kp P              &kp LBKT
&kp LSHIFT  &kp A                &kp S         &kp D         &kp F         &kp G   &kp H         &kp J      &kp K       &kp L    &kp SEMICOLON      &kp SQT
&kp LCTRL   &kp Z                &kp X         &kp C         &kp V         &kp B   &kp N         &kp M      &kp COMMA   &kp DOT  &kp FSLH           &kp RBKT
&kp ESCAPE  &kp LA(PRINTSCREEN)  &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE     &mo 1   &mo 2         &kp ENTER  &kp RSHIFT  &none    &kp K_APPLICATION  &kp BSLH
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp BACKSPACE DELETE>;
        };

        LAYER1 {
            display-name = "NUM";
            bindings = <
&kp ESC  &kp F1     &kp F2          &kp F3     &kp F4           &kp F5                 &kp F6                 &kp F7  &kp F8  &kp F9  &kp F10         &kp F11
&trans   &mkp MCLK  &msc SCRL_LEFT  &kp UP     &msc SCRL_RIGHT  &kp MINUS              &kp EQUAL              &kp N7  &kp N8  &kp N9  &kp N0          &kp F12
&trans   &kp LEFT   &kp LEFT        &kp DOWN   &kp RIGHT        &kp LEFT_PARENTHESIS   &kp LEFT_PARENTHESIS   &kp N4  &kp N5  &kp N6  &kp UNDERSCORE  &kp EQUAL
&trans   &kp HOME   &kp PG_DN       &kp PG_UP  &kp END          &kp RIGHT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp N1  &kp N2  &kp N3  &kp LS(N7)      &kp PRINTSCREEN
&trans   &trans     &trans          &trans     &trans           &to 3                  &to 3                  &trans  &trans  &trans  &trans          &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&encoder_sc SCRL_UP SCRL_DOWN>;
        };

        LAYER2 {
            display-name = "BT";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &out OUT_TOG     &out OUT_BLE  &out OUT_USB   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &kp UNDERSCORE  &kp PLUS         &trans        &kp UP         &trans                &trans                 &kp PIPE
&trans          &trans        &trans        &trans        &trans        &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT      &kp DOWN       &kp RIGHT             &kp COLON              &kp DOUBLE_QUOTES
&trans          &trans        &trans        &trans        &trans        &trans          &trans           &trans        &kp LESS_THAN  &kp GREATER_THAN      &kp QUESTION           &trans
&trans          &trans        &trans        &trans        &trans        &trans          &trans           &trans        &trans         &trans                &trans                 &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp UP_ARROW DOWN>;
        };

        LAYER3 {
            display-name = "GAME";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4     &kp N5  &kp N6  &kp N7    &kp N8     &kp N9     &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W   &kp E   &kp R      &kp T   &kp Y   &kp U     &kp UP     &kp O      &kp P     &kp LBKT
&kp LSHFT  &kp A   &kp S   &kp D   &kp F      &kp G   &kp H   &kp LEFT  &kp DOWN   &kp RIGHT  &kp SEMI  &kp APOS
&kp LCTRL  &kp Z   &kp X   &kp C   &kp V      &kp B   &kp N   &kp M     &kp COMMA  &kp DOT    &kp FSLH  &kp EQUAL
&kp LALT   &trans  &trans  &trans  &kp SPACE  &to 0   &to 0   &trans    &trans     &trans     &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };
    };
};
